# Static IPv4 rules for Proxmox LAN and Tailscale homelab entrypoints.
# GENERATED by scripts/gen-routes.js from services/routes.yaml.
# Ansible installs this as /etc/iptables/rules.v4 for reboot persistence.
# Do not reload this live with netfilter-persistent while Tailscale is running;
# the proxmox_network role applies live rules idempotently with iptables.
#
# LAN clients use 192.0.2.10. Tailscale clients use 100.64.0.10.
# LAN DNS terminates on dnsmasq at 192.0.2.10 and is forwarded to Pi-hole.
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A PREROUTING -i eth0 -p tcp -m tcp --dport 80 -j DNAT --to-destination 10.20.0.45:80
-A PREROUTING -i eth0 -p tcp -m tcp --dport 443 -j DNAT --to-destination 10.20.0.45:443
-A PREROUTING -i eth0 -p udp -m udp --dport 443 -j DNAT --to-destination 10.20.0.45:443
-A PREROUTING -i tailscale0 -p tcp -m tcp --dport 80 -j DNAT --to-destination 10.20.0.45:80
-A PREROUTING -i tailscale0 -p tcp -m tcp --dport 443 -j DNAT --to-destination 10.20.0.45:443
-A PREROUTING -i tailscale0 -p udp -m udp --dport 443 -j DNAT --to-destination 10.20.0.45:443
-A POSTROUTING -s 10.20.0.0/24 -o eth0 -j MASQUERADE
COMMIT

*raw
:PREROUTING ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
COMMIT

*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A FORWARD -i eth0 -o vmbr0 -p tcp -d 10.20.0.45 -m tcp --dport 80 -j ACCEPT
-A FORWARD -i eth0 -o vmbr0 -p tcp -d 10.20.0.45 -m tcp --dport 443 -j ACCEPT
-A FORWARD -i eth0 -o vmbr0 -p udp -d 10.20.0.45 -m udp --dport 443 -j ACCEPT
-A FORWARD -i tailscale0 -o vmbr0 -p tcp -d 10.20.0.45 -m tcp --dport 80 -j ACCEPT
-A FORWARD -i tailscale0 -o vmbr0 -p tcp -d 10.20.0.45 -m tcp --dport 443 -j ACCEPT
-A FORWARD -i tailscale0 -o vmbr0 -p udp -d 10.20.0.45 -m udp --dport 443 -j ACCEPT
-A FORWARD -i eth0 -o vmbr0 -m state --state RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -i tailscale0 -o vmbr0 -m state --state RELATED,ESTABLISHED -j ACCEPT
-A FORWARD -i vmbr0 -o eth0 -j ACCEPT
-A FORWARD -i vmbr0 -o tailscale0 -j ACCEPT
COMMIT
